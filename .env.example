# Groq API key for the router (openai/gpt-oss-20b) and synthesizer (openai/gpt-oss-120b)
# Get one at https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# Shared secret between the frontend and backend containers, checked on every /query request
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
BACKEND_API_KEY=your_shared_secret_here

# Where the frontend sends queries. Defaults to localhost for plain-Python runs;
# set to http://backend:8000/query when running via docker-compose.
BACKEND_URL=http://127.0.0.1:8000/query

# Backend only. When "true", the backend rate-limits by the end-user IP that the frontend sends in
# the X-End-User-IP header (only for requests that also carry the valid internal key). When false,
# it uses the connection IP, which behind the frontend is the frontend's own IP for every user.
# Set to "true" on the deployed backend; leave false for local runs.
TRUST_PROXY_HEADERS=false

# Backend only. New (uncached) answers per UTC day across all users, to keep Groq spending
# predictable. 0 means no limit.
DAILY_ANSWER_LIMIT=50

# Ingestion only (python -m app.ingestion.download_filings). SEC's fair-access policy requires a
# real name and contact email in the User-Agent of every request to EDGAR.
SEC_USER_AGENT_NAME=your_name_or_project_name
SEC_USER_EMAIL=you@example.com

# Optional, evaluation only (python -m eval.run_eval). A separate Groq key so evaluation runs
# do not use up the quota of the key the app runs on. Falls back to GROQ_API_KEY when unset.
EVAL_GROQ_API_KEY=
