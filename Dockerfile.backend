FROM python:3.13-slim
WORKDIR /app
# Unbuffered stdout/stderr — without this, Python fully buffers output when it's not
# attached to a TTY (always true in a container), so log lines (including tracebacks)
# can sit invisible in the buffer instead of reaching `docker logs` in real time.
ENV PYTHONUNBUFFERED=1
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

# Run as a non-root user, not the default root — limits the blast radius if the
# container is ever compromised (e.g. via a dependency RCE). Created before the
# model download step so those files land under this user's home with the
# right ownership, instead of under /root where the runtime user couldn't read them.
RUN useradd --create-home --shell /bin/false appuser
USER appuser

# Download the embedding model at build time so the container does not fetch it on startup.
# (NLTK data is only needed by the parsing pipeline, which does not run in this image.)
RUN python -c "from llama_index.embeddings.huggingface import HuggingFaceEmbedding; HuggingFaceEmbedding(model_name='BAAI/bge-large-en-v1.5')"
COPY --chown=appuser:appuser app ./app
# Bake the Qdrant index into the image — Azure Container Apps has no equivalent of the
# local bind-mount (docker-compose.yml's ./data/qdrant_db volume), so without this the
# container has no vector data to serve at all. Means the image must be rebuilt/pushed
# whenever the underlying filing index changes — acceptable at this project's scale.
COPY --chown=appuser:appuser data/qdrant_db ./data/qdrant_db
EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
